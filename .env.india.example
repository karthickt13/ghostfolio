# Copy to .env and fill in the values of your Neon and Supabase projects.
# See docs/india-setup.md for the full guide.

# CACHE
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<INSERT_REDIS_PASSWORD>

# NEON (Postgres)
# Pooled connection string for the application
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>-pooler.<REGION>.aws.neon.tech/ghostfolio?sslmode=require&connect_timeout=300
# Direct connection string, used for migrations only
DIRECT_URL=postgresql://<USER>:<PASSWORD>@<HOST>.<REGION>.aws.neon.tech/ghostfolio?sslmode=require&connect_timeout=300

# SUPABASE (login and archive of the weekly uploads)
ENABLE_FEATURE_AUTH_SUPABASE=true
SUPABASE_URL=https://<PROJECT>.supabase.co
SUPABASE_ANON_KEY=<INSERT_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<INSERT_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=tradebooks

# INDIAN MARKET
# Base currency of new users
DEFAULT_CURRENCY=INR
# Resolves RELIANCE.NS and TCS.BO
DATA_SOURCE_IMPORT=YAHOO
DATA_SOURCE_EXCHANGE_RATES=YAHOO

# VARIOUS
ACCESS_TOKEN_SALT=<INSERT_RANDOM_STRING>
JWT_SECRET_KEY=<INSERT_RANDOM_STRING>
ROOT_URL=http://localhost:4200
